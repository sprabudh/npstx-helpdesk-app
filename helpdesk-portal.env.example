# Copy to ~/Desktop/helpdesk-portal.env (chmod 600, never commit). Used by docker-compose.portal.yml.
# The service secret is shown once when the application "helpdesk" is added in the portal
# (Dashboard -> Add Application: key helpdesk, URL http://helpdesk.npst.localhost:8080/).
PLATFORM_SERVICE_SECRET=
PLATFORM_IAM_URL=http://iam-api:3000
PLATFORM_TENANT_ID=a0000000-0000-0000-0000-000000000001
PORTAL_URL=http://portal.npst.localhost:8080/
HELPDESK_PUBLIC_URL=http://helpdesk.npst.localhost:8080
# Broker user "helpdesk" (auth_gateway: infra/notification-bus/users.acl). Development password.
NOTIFICATION_BUS_URL=redis://helpdesk:bus-helpdesk-dev-password@notification-bus:6379
