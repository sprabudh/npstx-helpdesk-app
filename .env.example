# Copy to .env and adjust. Never commit .env. All secrets are read from the environment only.

# ---- Database (MySQL 8) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=helpdesk
DB_PASSWORD=change-me-local-only
DB_NAME=helpdesk
MYSQL_ROOT_PASSWORD=change-me-root-local-only

# ---- API ----
BACKEND_PORT=3000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Long random string; the token carries only the user id. Roles are loaded from the DB on every request.
JWT_SECRET=replace-with-a-long-random-string
JWT_TTL_SECONDS=1800
# demo = persona switcher (POST /api/auth/demo-login); oidc = verify RS256 tokens from your IdP;
# portal = signed in through the NPST portal (docker-compose.portal.yml, helpdesk-portal.env.example)
AUTH_MODE=demo
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_USER_CLAIM=email

# ---- Demo behaviour ----
# true enables the persona switcher, demo states and POST /api/demo/reset. The clock is always real time.
DEMO_MODE=true
DISPLAY_TIME_ZONE=Asia/Kolkata

# ---- Jobs and storage ----
SLA_SCHEDULER_ENABLED=true
OUTBOX_INTERVAL_MS=15000
EMAIL_ADAPTER=console
UPLOAD_DIR=./uploads

# ---- AI ----
# rules = built-in rule engine (no external calls, the default); anthropic = Claude via the API key below; none = AI off
AI_PROVIDER=rules
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_TIMEOUT_MS=15000

# ---- Salesforce ----
# mock = in-process mock adapter; rest = OAuth client-credentials REST adapter (not verified against a live org)
SALESFORCE_ADAPTER=mock
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=v61.0
