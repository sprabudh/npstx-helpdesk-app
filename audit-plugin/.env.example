# Auditr Configuration
PORT=5050
HOST=0.0.0.0
LOG_LEVEL=info

# Optional API Key (leave empty to disable API key requirement)
AUDITR_API_KEY=

# Cryptographic Salt for Tamper-Evident Hash Chain
AUDITR_HASH_SECRET=auditr-production-integrity-secret-salt-2026

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=auditr_user
DB_PASSWORD=auditr_secret
DB_NAME=auditr_db
DB_CONNECTION_LIMIT=10
DB_ROOT_PASSWORD=auditr_root_secret

# Service URL (for CLI and SDK)
AUDITR_URL=http://localhost:5050
